{
  "name": "pulse-android",
  "version": "0.6.7",
  "private": true,
  "description": "Pulse Notes — markdown editor for Android (Capacitor 8 + Svelte 5 web bundle).",
  "type": "module",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "test": "cd web && vitest run",
    "build:web": "node scripts/build-web.mjs",
    "build:debug": "npm run build:web && cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  }
}
