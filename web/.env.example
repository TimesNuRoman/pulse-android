# Pulse Notes — build-time environment variables.
#
# Copy this file to `.env` and override per-build. Variables prefixed
# with `VITE_` are inlined into the bundle at build time (read via
# `import.meta.env.VITE_*`). Anything not prefixed is server-side only.
#
# Pulse Notes R88 (UpdateChecker revival): the in-app UpdateChecker
# polls a remote manifest to decide whether to prompt the user. The
# manifest URL is the only knob you should ever need to change in
# production. Defaults are wired in src/lib/update-checker/update-checker.ts.

# Remote manifest URL polled by the in-app UpdateChecker.
# Default: https://hrkbksh0x0xz4.space.minimax.io/updates/android.json (R87 host)
# VITE_UPDATE_MANIFEST_URL=https://your-host.example.com/updates/android.json

# Installed app version, surfaced in the UpdateDialog and used for the
# "is this an update?" compare. MUST match android/app/build.gradle.
# Default if unset: 0.6.3
# VITE_APP_VERSION=0.6.3

# Installed app version code (integer), used for the same compare.
# MUST match android/app/build.gradle versionCode.
# Default if unset: 13
# VITE_APP_VERSION_CODE=13
