<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Dark first — Pulse Notes is DARK only. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!--
      Launch theme: M3 SplashScreen API (androidx.core:core-splashscreen 1.2.0).
      windowSplashScreenBackground is set to Tokyo Night #1a1b26 so the very
      first frame after process start is dark — no white flash before
      Capacitor's splash.png takes over.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
