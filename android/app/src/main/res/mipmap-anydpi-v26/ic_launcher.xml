<?xml version="1.0" encoding="utf-8"?>
<!--
  R246 - adaptive-icon manifest (Android 8+ / API 26+).
  - background: @color/ic_launcher_background, solid Tokyo Night #1a1b26
    (replaces the R166 gradient vector - solid is simpler, lighter to
    render, and identical on every launcher mask)
  - foreground: ic_launcher_foreground, the R244 paper-plane mark in
    Tokyo Night cyan + dark blue
  - monochrome: ic_launcher_monochrome, white silhouette for Android 13+
    themed icons (the system tints it to match the user's wallpaper)
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
