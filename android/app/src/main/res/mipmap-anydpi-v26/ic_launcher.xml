<?xml version="1.0" encoding="utf-8"?>
<!--
  R166 — adaptive-icon manifest (Android 8+ / API 26+).
  - background: ic_launcher_background (vector with Tokyo Night gradient).
    Replaces the @color/ic_launcher_background ref that R95b used; the
    gradient gives the icon depth on every launcher mask.
  - foreground: ic_launcher_foreground (P+spark mark in Tokyo Night palette).
  - monochrome: ic_launcher_monochrome (white-on-transparent for Android 13+
    themed icons; the system tints it to match the user's wallpaper).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
