<?xml version="1.0" encoding="utf-8"?>
<!--
  R246 - Pulse adaptive-icon foreground (paper plane mark).
  Replaces the R166 P+spark with the paper-plane from R244 EmptyState.
  Geometry is scaled from the R244 viewBox (64x64) to the Android
  108x108dp viewport, then translated so the plane sits centered in
  the 66x66 safe zone (21..87 on each axis):
    left tip   ( 30, 54 )
    right tip  ( 78, 34 )
    bottom-tip ( 64, 74 )
    fold point ( 52, 58 )
  The fold splits the silhouette into an upper wing (#7aa2f7, cyan)
  and a lower wing (#3d59a1, Tokyo Night dark blue) so the plane
  reads as a folded plane rather than a kite. Both colors are from
  the existing Tokyo Night palette - no new tokens introduced.
  Used by mipmap-anydpi-v26/ic_launcher.xml as <foreground>.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Upper wing (cyan, the main brand color). -->
    <path
        android:fillColor="#7aa2f7"
        android:pathData="M30,54 L78,34 L52,58 Z" />

    <!-- Lower wing (Tokyo Night dark blue, suggests the fold). -->
    <path
        android:fillColor="#3d59a1"
        android:pathData="M30,54 L52,58 L64,74 Z" />
</vector>
