<?xml version="1.0" encoding="utf-8"?>
<!--
  R173 - Widget background. Rounded 16dp corners on the dark Tokyo Night
  surface. system_widget_background would also work on API 31+ but we
  pin to a solid fill so the widget looks the same on API 26 (minSdk).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1a1b26" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#414868" />
</shape>
