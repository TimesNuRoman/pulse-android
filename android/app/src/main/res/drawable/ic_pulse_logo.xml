<?xml version="1.0" encoding="utf-8"?>
<!--
  R166 — Pulse master mark.
  The "P" letterform + 4-point spark, in the 108x108dp viewport that
  the Android adaptive-icon spec uses. The mark sits inside the inner
  66x66dp safe zone (21..87 on both axes) so any OEM launcher mask
  (circle / squircle / teardrop / rounded square) keeps it legible.
  Foreground copy of this file is ic_launcher_foreground.xml; monochrome
  (Android 13 themed icons) is ic_launcher_monochrome.xml.
  Color refs: #7aa2f7 (Tokyo Night blue) for the P, #bb9af7 (Tokyo Night
  purple) for the spark. Background gradient lives in
  ic_launcher_background.xml. This file is also the input for the
  raster PNGs in tools/render-icon-pngs.mjs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- "P" letter, hollow bowl (even-odd fill) -->
    <path
        android:fillColor="#7aa2f7"
        android:fillType="evenOdd"
        android:pathData="M 30,28 L 30,80 L 40,80 L 40,64 L 58,64 C 68,64 74,57 74,48 C 74,39 68,28 58,28 L 30,28 Z M 40,38 L 58,38 C 62,38 65,42 65,48 C 65,52 62,56 58,56 L 40,56 L 40,38 Z" />

    <!-- 4-point spark (pulse), upper-right of the P -->
    <path
        android:fillColor="#bb9af7"
        android:pathData="M 84,24 L 86,32 L 94,34 L 86,36 L 84,44 L 82,36 L 74,34 L 82,32 Z" />
</vector>
