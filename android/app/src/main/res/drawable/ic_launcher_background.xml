<?xml version="1.0" encoding="utf-8"?>
<!--
  R166 — adaptive-icon background.
  Tokyo Night vertical gradient #1a1b26 (top) -> #16161e (bottom).
  Replaces the R95b grid pattern: the grid rendered as visual noise
  at small sizes (48dp) and on themed launchers. A gradient is
  density-independent and looks correct on every launcher mask.
  Used by mipmap-anydpi-v26/ic_launcher.xml as <background>.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#1a1b26" />
                <item android:offset="1.0" android:color="#16161e" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
