<?xml version="1.0" encoding="utf-8"?>
<!--
  R246 - Pulse monochrome icon (Android 13+ themed icons).
  The system tints this to match the wallpaper / theme color, so we
  ship the paper-plane silhouette in solid white on transparent.
  Both wings collapse to one color under the system tint (no depth
  visible after tinting), but the outline still reads as a paper
  plane. Same geometry as drawable/ic_launcher_foreground.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper plane silhouette (white, system-tints to theme color). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,54 L78,34 L64,74 L52,58 L30,54 Z" />
</vector>
