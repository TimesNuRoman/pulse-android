# Template for keystore.properties.
# Copy this file to keystore.properties and fill in your real values.
# The real keystore.properties file is gitignored.
# Generate a keystore with:
#   keytool -genkey -v -keystore release.keystore -alias pulse-release -keyalg RSA -keysize 2048 -validity 10000 -storepass <storepass> -keypass <keypass> -dname "CN=Pulse Notes, OU=Pulse, O=Lesside, L=Brest, S=Brest, C=BY"

storeFile=release.keystore
storePassword=CHANGEME_storepass
keyAlias=pulse-release
keyPassword=CHANGEME_keypass
